# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올라가지 않습니다)

# Supabase 대시보드 → Project Settings → API (또는 Connect 버튼)에서 확인
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...) 또는 예전 방식의 anon public 키를 넣으세요.
# 절대 secret / service_role 키를 넣지 마세요. RLS를 무시하는 키라서 서버가 시작을 거부합니다.
SUPABASE_PUBLISHABLE_KEY=

# 서버 포트와 접속 주소. 내 컴퓨터에서는 그대로 두고, 클라우드에서는 HOST=0.0.0.0
PORT=3000
HOST=127.0.0.1

# 클라우드 배포 시 production으로 설정 (로그인 쿠키를 HTTPS 전용으로 만듦)
NODE_ENV=development

# (선택) npm run check:rls 에서 쓰는 시험용 계정 두 개. 앱에서 회원가입한 시험용 계정을 넣으세요.
# 클라우드 서버에는 넣지 않습니다.
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=
